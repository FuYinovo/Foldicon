<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Foldicon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:converter="using:Foldicon.Converter"
    mc:Ignorable="d"
    Title="Foldicon">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            SelectionChanged="NavigationView_OnSelectionChanged"
            OpenPaneLength="250"
            IsBackButtonVisible="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Edit" Content="图标编辑器" Tag="IconEditor" />
                <NavigationViewItemHeader Content="图标库" />
                <NavigationViewItem Icon="{ui:FontIcon Glyph=&#xE7C5;}"
                                    Content="首页"
                                    Tag="IconGroup" />
                <NavigationViewItem Icon="{ui:FontIcon Glyph=&#xE7B8;}"
                                    Content="详情"
                                    IsEnabled="{x:Bind CountToBool(IconGroups.Count), Mode=OneWay}"
                                    MenuItemsSource="{x:Bind IconGroups}">
                </NavigationViewItem>
                <!-- Window 类不满足使用 Converter 要求的 FrameworkElement 类 -->
                <!-- 使用 CountToBool() 替代 CountToBoolConverter -->
                <NavigationViewItem Icon="{ui:FontIcon Glyph=&#xE97C;}"
                                    Content="分类"
                                    IsEnabled="{x:Bind CountToBool(IconGroups.Count), Mode=OneWay}"
                                    MenuItemsSource="{x:Bind IconGroups}" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Padding="24" CacheSize="16" />
        </NavigationView>
    </Grid>
</Window>