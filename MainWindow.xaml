<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Foldicon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:foldicon="using:Foldicon"
    xmlns:class="using:Foldicon.Class"
    mc:Ignorable="d"
    Title="Foldicon">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            SelectionChanged="NavigationView_OnSelectionChanged"
            OpenPaneLength="250"
            IsBackButtonVisible="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Edit" Content="图标编辑器" Tag="IconEditor" />
                <NavigationViewItemHeader Content="图标库" />
                <NavigationViewItem Icon="{ui:FontIcon Glyph=&#xE7C5;}"
                                    Content="首页"
                                    Tag="IconGroup"/>
                <NavigationViewItem Icon="{ui:FontIcon Glyph=&#xE7B8;}"
                                    Content="详情"
                                    MenuItemsSource="{x:Bind foldicon:MainWindow.IconGroups}">
                </NavigationViewItem>
                <NavigationViewItem Icon="{ui:FontIcon Glyph=&#xE97C;}"
                                    Content="分类" IsEnabled="False"
                                    MenuItemsSource="{x:Bind foldicon:MainWindow.IconGroups}"/>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Padding="24" CacheSize="16" />
        </NavigationView>
    </Grid>
</Window>