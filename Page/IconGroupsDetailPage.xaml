<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Foldicon.Page.IconGroupsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:control="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:converter="using:Foldicon.Converter"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:IntToStringConverter x:Key="IntToStringConverter" />
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="8">
                <TextBlock Text="视图模式" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <control:Segmented HorizontalAlignment="Left" x:Name="ViewModeSegmented" SelectedIndex="0">
                    <control:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE8A9;}" Content="大图标" />
                    <control:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE8FD;}" Content="小图标" />
                </control:Segmented>
            </StackPanel>
            <Button Content="导入图标" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Spacing="8" Grid.Row="1">
            <TextBlock Text="类别筛选" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <labs:TokenView IsWrapped="True" SelectionMode="Multiple">
                <labs:TokenItem Content="All" IsSelected="True" />
                <labs:TokenItem Content="Apps">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xECAA;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="Work">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE821;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="Documents">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="Web">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="Settings">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="People">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="Folders">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
                <labs:TokenItem Content="Photos">
                    <labs:TokenItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </labs:TokenItem.Icon>
                </labs:TokenItem>
            </labs:TokenView>
        </StackPanel>

        <Line Grid.Row="2"
              Stroke="{ThemeResource AccentAAFillColorDisabled}"
              X1="0" Y1="0"
              X2="999999" Y2="0"
              StrokeThickness="1" />

        <control:SwitchPresenter
            Grid.Row="3"
            Value="{Binding SelectedIndex, ElementName=ViewModeSegmented, Converter={StaticResource IntToStringConverter}}">
            <control:Case Value="0">
                <control:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button Width="74"
                            Height="100"
                            Padding="4"
                            Background="{ThemeResource CardBackgroundFillColorDefault}">
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="删除图标" Icon="Delete" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <StackPanel>
                            <Image Width="64" Height="64" Source="F:\Folder11-Icon\3d_coat.ico" />
                            <TextBlock Text="3d_coat"
                                       MaxWidth="60"
                                       TextWrapping="NoWrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Button>
                </control:WrapPanel>
            </control:Case>

            <control:Case Value="1">
                <control:WrapPanel HorizontalSpacing="4" VerticalSpacing="4">
                    <Button Width="40"
                            Height="40"
                            Padding="4"
                            ToolTipService.ToolTip="3d_coat"
                            Background="{ThemeResource CardBackgroundFillColorDefault}">
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="删除图标" Icon="Delete" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <Image Width="32" Height="32" Source="F:\Folder11-Icon\3d_coat.ico" />
                    </Button>
                </control:WrapPanel>
            </control:Case>
        </control:SwitchPresenter>
    </Grid>
</Page>