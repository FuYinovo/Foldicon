<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Foldicon.Page.IconGroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Right">
            <SplitButton Content="导入文件夹">
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="导入图标" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>

        <Line Grid.Row="1"
          Stroke="{ThemeResource AccentAAFillColorDisabled}"
          X1="0" Y1="0"
          X2="999999" Y2="0"
          StrokeThickness="1" />

        <Grid Grid.Row="2">
            <controls:WrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                <Button
                    Padding="-5,0,0,0"
                    Width="310"
                    Height="145"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">

                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导入图标" Icon="Add" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="编辑信息" Icon="Edit" />
                            <MenuFlyoutItem Text="删除图标组" Icon="Delete" />
                        </MenuFlyout>

                    </Button.ContextFlyout>

                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="2">
                        <Image Width="128"
                               Height="128"
                               HorizontalAlignment="Left"
                               Source="F:\Folder11-Icon\folder11.ico" />
                        <StackPanel Spacing="2" MaxWidth="160">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}"
                                       TextWrapping="NoWrap"
                                       FontWeight="SemiBold"
                                       Text="Folder 11" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="NoWrap"
                                       Text="路径：F:\Icons\" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="NoWrap"
                                       Text="数量：32" />
                            <TextBlock
                                MaxHeight="60"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Windows 11 风格的文件夹图标集合，与 Fluent UI 设计语言保持一致"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </controls:WrapPanel>
        </Grid>
    </Grid>
</Page>