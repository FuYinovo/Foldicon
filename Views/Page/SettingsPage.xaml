<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Foldicon.Views.Page.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:winUi="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">


    <Grid>
        <StackPanel Spacing="36">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
            <!-- 外观 -->
            <StackPanel Spacing="6">
                <TextBlock Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <community:SettingsCard Header="应用主题"
                                        Description="指定应用的主题样式"
                                        HeaderIcon="{winUi:FontIcon Glyph=&#xE790;}">
                    <ComboBox
                        SelectedItem="{x:Bind ViewModel.SelectedAppTheme, Mode=TwoWay}"
                        ItemsSource="{x:Bind ViewModel.AppThemes}"
                        />
                </community:SettingsCard>
                <community:SettingsCard Header="应用背景"
                                        Description="指定应用的背景样式"
                                        HeaderIcon="{winUi:FontIcon Glyph=&#xEF1F;}">
                    <ComboBox
                        SelectedItem="{x:Bind ViewModel.SelectedAppBackdrop, Mode=TwoWay}"
                        ItemsSource="{x:Bind ViewModel.AppBackdrops}"
                    />
                </community:SettingsCard>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="6">
                <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <community:SettingsCard Header="FoldIcon" Description="一个由 WinUI3 框架开发的文件夹图标编辑工具"
                                        HeaderIcon="{winUi:FontIcon Glyph=&#xE897;}" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>