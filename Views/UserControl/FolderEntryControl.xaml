<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Foldicon.Views.UserControl.FolderEntryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:struct="using:Foldicon.Struct"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:contracts="using:Foldicon.Contracts"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
            <!-- 文件夹当前图标 -->
            <Image Width="32"
                   Height="32"
                   Source="{x:Bind ViewModel.FolderEntry.CurrentIcon.Bitmap, Mode=OneWay}" />
            <!-- 文件夹名称 -->
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.FolderEntry.FolderName, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <!-- 文件夹可选自定义图标 -->
            <ComboBox
                ItemsSource="{x:Bind ViewModel.FolderEntry.OptionalIcons, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.FolderEntry.SelectedIcon, Mode=OneWay}"
                SelectionChanged="Selector_OnSelectionChanged">
                <!-- 防止 TwoWay 在虚拟化控件回收时覆写 null 污染数据 -->
                <!-- SelectionChanged 手动实现安全 TwoWay -->
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="contracts:IFolderIcon">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Image Width="24"
                                   Height="24"
                                   Source="{x:Bind Bitmap}"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayName}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- 选择其他自定义图标 -->
            <DropDownButton Content="浏览">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Icon="{ui:FontIcon Glyph=&#xEC50; }"
                            Text="从文件"
                            Command="{x:Bind ViewModel.PickIconFromFileCommand}"/>
                        <MenuFlyoutSubItem
                            x:Name="PickIconFromGroupFlyout"
                            Icon="{ui:FontIcon Glyph=&#xE7B8; }"
                            Text="从图标库">
                            <!-- C#代码动态生成 -->
                            <!-- <MenuFlyoutItem Click="PickOtherIconFromGroup_Click"  -->
                            <!--                 Tag="{x:Bind group}" -->
                            <!--                 Text="{x:Bind groupName}"/> -->
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <!-- 应用自定义图标 -->
            <Button
                IsEnabled="{x:Bind ViewModel.FolderEntry.IsSelectedIconChanged, Mode=OneWay}"
                Command="{x:Bind ViewModel.ApplyCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                Padding="18,6"
                Content="应用" />
        </StackPanel>

    </Grid>
</UserControl>