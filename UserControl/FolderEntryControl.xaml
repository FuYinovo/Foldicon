<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Foldicon.UserControl.FolderEntryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:struct="using:Foldicon.Struct"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <!-- 文件夹当前图标 -->
            <Image Width="32" Height="32" Source="{x:Bind FolderEntry.CurrentIcon, Mode=OneWay}" />
            <!-- 文件夹名称 -->
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind FolderEntry.FolderName, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <!-- 文件夹可选自定义图标 -->
            <ComboBox
                ItemsSource="{x:Bind FolderEntry.OptionalIcons, Mode=OneWay}"
                SelectedIndex="{x:Bind FolderEntry.SelectedIndex, Mode=OneWay}"
                SelectionChanged="IconSelector_Changed">
                <!-- SelectedIndex 设为 OneWay，防止 TwoWay 在虚拟化控件回收时覆写 -1 污染数据 -->
                <!-- SelectionChanged 手动处理 UI 操作 -->
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="struct:FileIcon">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="24" Height="24" Source="{x:Bind Icon}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind FullPath}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- 选择其他自定义图标 -->
            <Button Content="浏览" Click="PickOtherIconButton_Click" />
            <!-- 应用自定义图标 -->
            <Button
                IsEnabled="{x:Bind FolderEntry.IsSelectedIconChanged, Mode=OneWay}"
                Click="ApplyButton_Click"
                Style="{ThemeResource AccentButtonStyle}"
                Padding="18,6"
                Content="应用" />
        </StackPanel>

    </Grid>
</UserControl>