<?xml version="1.0" encoding="utf-8"?>

<Page NavigationCacheMode="Enabled"
      x:Class="Foldicon.Xaml.Page.IconEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:class="using:Foldicon.Class"
      xmlns:converter="using:Foldicon.Converter"
      xmlns:converters="using:CommunityToolkit.WinUI.Converters"
      xmlns:userControl1="using:Foldicon.Xaml.UserControl"
      mc:Ignorable="d">

    <Page.Resources>
        <converter:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="2">
                <TextBlock Text="图标编辑器"
                           Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind FilteredSubFolders.Count, Mode=OneWay,
                    Converter={StaticResource StringFormatConverter},
                    ConverterParameter=' {0}个文件夹'}"
                           Opacity=".6"
                           VerticalAlignment="Bottom"
                           Padding="0,0,0,5"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ParentFolder, Mode=OneWay,
                    Converter={StaticResource StringFormatConverter},
                    ConverterParameter='  ( {0} )'}"
                    Opacity=".6"
                    VerticalAlignment="Bottom"
                    Padding="0,0,0,5"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <AutoSuggestBox
                    Text="{x:Bind FolderNameFilter, Mode=TwoWay}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Height="32"
                    Width="200"
                    PlaceholderText="搜索文件夹名称..."
                    BorderThickness="0"
                    QueryIcon="Find"
                    IsEnabled="{x:Bind IsSubFoldersLoaded, Mode=OneWay}" />

                <Button
                    VerticalAlignment="Bottom"
                    Content="打开文件夹"
                    Click="PickFolderButton_Click" />

                <Button
                    Style="{ThemeResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    Click="ApplyAllButton_Click"
                    Content="全部应用"
                    IsEnabled="{x:Bind IsSubFoldersLoaded, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Line Grid.Row="1"
              Stroke="{ThemeResource AccentAAFillColorDisabled}"
              X1="0" Y1="0"
              X2="999999" Y2="0"
              StrokeThickness="1" />

        <Grid Grid.Row="2">
            <SplitButton
                HorizontalAlignment="Right"
                IsEnabled="{x:Bind IsSubFoldersLoaded, Mode=OneWay}"
                Padding="0">
                <ToggleButton Content="启用筛选"
                              Click="EnableEnumFilterButton_OnClick"
                              IsChecked="{x:Bind IsEnumFilterEnabled, Mode=TwoWay}" />
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem Text="全部"
                                             Click="TypeFilterItem_Click"
                                             Tag="All"
                                             GroupName="TypeGroup"
                                             IsChecked="{x:Bind FolderTypeFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=All}" />
                        <RadioMenuFlyoutItem Text="系统默认"
                                             Click="TypeFilterItem_Click"
                                             Tag="System"
                                             GroupName="TypeGroup"
                                             IsChecked="{x:Bind FolderTypeFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=System}" />
                        <RadioMenuFlyoutItem Text="自定义图标"
                                             Click="TypeFilterItem_Click"
                                             Tag="Custom"
                                             GroupName="TypeGroup"
                                             IsChecked="{x:Bind FolderTypeFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Custom}" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem Text="全部"
                                             Tag="All"
                                             Click="StateFilterItem_Click"
                                             GroupName="StateGroup"
                                             IsChecked="{x:Bind FolderStateFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=All}" />
                        <RadioMenuFlyoutItem Text="未修改项"
                                             Click="StateFilterItem_Click"
                                             Tag="Unmodified"
                                             GroupName="StateGroup"
                                             IsChecked="{x:Bind FolderStateFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Unmodified}" />
                        <RadioMenuFlyoutItem Text="待应用项"
                                             Click="StateFilterItem_Click"
                                             Tag="Unapplied"
                                             GroupName="StateGroup"
                                             IsChecked="{x:Bind FolderStateFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Unapplied}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer
                Visibility="{x:Bind IsSubFoldersLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsRepeater ItemsSource="{x:Bind FilteredSubFolders, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="class:FolderEntry">
                            <userControl1:FolderEntryControl FolderEntry="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <TextBlock Text="(´･ω･`) 空空如也……&#10;请先打开一个文件夹吧！"
                       FontSize="40"
                       FontWeight="Black"
                       Opacity=".3"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind IsSubFoldersLoaded, Mode=OneWay,
                       Converter={StaticResource BoolToVisibilityConverter},
                       ConverterParameter=True}" />
        </Grid>
    </Grid>
</Page>