<?xml version="1.0" encoding="utf-8"?>

<Page NavigationCacheMode="Enabled"
      x:Class="Foldicon.Xaml.Page.IconEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:class="using:Foldicon.Class"
      xmlns:converter="using:Foldicon.Converter"
      xmlns:converters="using:CommunityToolkit.WinUI.Converters"
      xmlns:userControl1="using:Foldicon.Xaml.UserControl"
      mc:Ignorable="d">

    <Page.Resources>
        <converter:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              RowSpacing="8"
              Padding="12"
              CornerRadius="4"
              Background="{ThemeResource CardBackgroundFillColorDefault}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid VerticalAlignment="Top" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <TextBox
                    IsEnabled="False"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="{x:Bind ParentFolder, Mode=OneWay}"
                    Grid.Column="0"
                    PlaceholderText="请选择文件夹路径..." />
                <Button
                    Click="PickFolderButton_Click"
                    Grid.Column="1"
                    Content="选择文件夹"
                    Margin="12,0,0,0" />

                <Button
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="ApplyAllButton_Click"
                    Grid.Column="2"
                    Content="应用所有图标"
                    Margin="6,0,0,0"
                    IsEnabled="{x:Bind IsSubFoldersLoaded, Mode=OneWay}" />

            </Grid>

            <Grid VerticalAlignment="Top" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox PlaceholderText="搜索文件夹名称..."
                                BorderThickness="0"
                                Grid.Column="0"
                                Text="{x:Bind FolderNameFilter, Mode=TwoWay}"
                                QueryIcon="Find"
                                IsEnabled="{x:Bind IsSubFoldersLoaded, Mode=OneWay}" />

                <SplitButton
                    IsEnabled="{x:Bind IsSubFoldersLoaded, Mode=OneWay}"
                    Grid.Column="1"
                    Padding="0"
                    Margin="12,0,0,0">
                    <ToggleButton Content="启用筛选"
                                  Click="EnableEnumFilterButton_OnClick"
                                  IsChecked="{x:Bind IsEnumFilterEnabled, Mode=TwoWay}" />
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem Text="全部"
                                                 Click="TypeFilterItem_Click"
                                                 Tag="All"
                                                 GroupName="TypeGroup"
                                                 IsChecked="{x:Bind FolderTypeFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=All}" />
                            <RadioMenuFlyoutItem Text="系统默认"
                                                 Click="TypeFilterItem_Click"
                                                 Tag="System"
                                                 GroupName="TypeGroup"
                                                 IsChecked="{x:Bind FolderTypeFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=System}" />
                            <RadioMenuFlyoutItem Text="自定义图标"
                                                 Click="TypeFilterItem_Click"
                                                 Tag="Custom"
                                                 GroupName="TypeGroup"
                                                 IsChecked="{x:Bind FolderTypeFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Custom}" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem Text="全部"
                                                 Tag="All"
                                                 Click="StateFilterItem_Click"
                                                 GroupName="StateGroup"
                                                 IsChecked="{x:Bind FolderStateFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=All}" />
                            <RadioMenuFlyoutItem Text="未修改项"
                                                 Click="StateFilterItem_Click"
                                                 Tag="Unmodified"
                                                 GroupName="StateGroup"
                                                 IsChecked="{x:Bind FolderStateFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Unmodified}" />
                            <RadioMenuFlyoutItem Text="待应用项"
                                                 Click="StateFilterItem_Click"
                                                 Tag="Unapplied"
                                                 GroupName="StateGroup"
                                                 IsChecked="{x:Bind FolderStateFilter, Mode=OneWay,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Unapplied}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer
                Visibility="{x:Bind IsSubFoldersLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsRepeater ItemsSource="{x:Bind FilteredSubFolders, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="class:FolderEntry">
                            <userControl1:FolderEntryControl FolderEntry="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <TextBlock Text="(´･ω･`) 空空如也……&#10;请先选择一个文件夹吧！"
                       FontSize="40"
                       FontWeight="Black"
                       Opacity=".3"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind IsSubFoldersLoaded, Mode=OneWay,
                       Converter={StaticResource BoolToVisibilityConverter},
                       ConverterParameter=True}" />
        </Grid>
    </Grid>
</Page>