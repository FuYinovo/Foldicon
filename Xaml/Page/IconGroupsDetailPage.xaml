<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Foldicon.Xaml.Page.IconGroupsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:control="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:converter="using:Foldicon.Converter"
    xmlns:struct="using:Foldicon.Struct"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:IntToStringConverter x:Key="IntToStringConverter" />
        <converter:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="8">
                <TextBlock Text="视图模式" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <control:Segmented HorizontalAlignment="Left" x:Name="ViewModeSegmented" SelectedIndex="0">
                    <control:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE8A9;}" Content="大图标" />
                    <control:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE8FD;}" Content="小图标" />
                </control:Segmented>
            </StackPanel>
            <Button Content="导入图标" HorizontalAlignment="Right" Click="ImportIcon_Click" />
        </Grid>

        <StackPanel Spacing="8" Grid.Row="1">
            <TextBlock Text="类别筛选" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <labs:TokenView
                SelectionChanged="CategoryFilter_Changed"
                IsWrapped="True"
                SelectionMode="Multiple"
                ItemsSource="{x:Bind Group.Categories, Mode=OneWay}" />
        </StackPanel>

        <Line Grid.Row="2"
              Stroke="{ThemeResource AccentAAFillColorDisabled}"
              X1="0" Y1="0"
              X2="999999" Y2="0"
              StrokeThickness="1" />

        <Grid Row="3">
            <ScrollViewer>
                <control:SwitchPresenter
                    Value="{Binding SelectedIndex, ElementName=ViewModeSegmented, Converter={StaticResource IntToStringConverter}}">
                    <control:Case Value="0">
                        <ItemsRepeater ItemsSource="{x:Bind Group.Icons, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <control:WrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                            </ItemsRepeater.Layout>

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="struct:BitmapIcon">
                                    <Button Width="74"
                                            Height="100"
                                            Padding="4"
                                            Click="Icon_Click"
                                            ToolTipService.ToolTip="{Binding FileName}"
                                            Background="{ThemeResource CardBackgroundFillColorDefault}">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="删除图标" Icon="Delete" Click="DeleteIcon_Click" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <StackPanel>
                                            <Image Width="64" Height="64" Source="{Binding Icon}" />
                                            <TextBlock Text="{Binding FileName}"
                                                       MaxWidth="60"
                                                       TextWrapping="NoWrap"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </control:Case>

                    <control:Case Value="1">
                        <ItemsRepeater ItemsSource="{x:Bind Group.Icons, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <control:WrapLayout HorizontalSpacing="4" VerticalSpacing="4" />
                            </ItemsRepeater.Layout>

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="struct:BitmapIcon">
                                    <Button Width="40"
                                            Height="40"
                                            Padding="4"
                                            ToolTipService.ToolTip="{Binding FileName}"
                                            Background="{ThemeResource CardBackgroundFillColorDefault}">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="删除图标" Icon="Delete" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <Image Width="32" Height="32" Source="{Binding Icon}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </control:Case>
                </control:SwitchPresenter>
            </ScrollViewer>

            <TextBlock Text="(｡•́︿•̀｡) 一个图标都没有呢……&#10;要不添加个新成员吧？"
                       FontSize="40"
                       FontWeight="Black"
                       Opacity=".3"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind Group.Icons.Count, Mode=OneWay,
                       Converter={StaticResource CountToVisibilityConverter},
                       ConverterParameter=True}" />
        </Grid>

    </Grid>
</Page>